{
  "name": "@ycp424c/dsh-browser-bridge",
  "version": "0.1.0",
  "description": "External DSH plugin (host + client) for the browser bridge",
  "host": "lib/index.js",
  "client": "lib/client.js",
  "bundle": "cordis.patch.yml",
  "config": {
    "pairingTtlMs": 30000,
    "grantTtlMs": 600000,
    "toolTimeoutMs": 60000,
    "consoleBufferSize": 200,
    "networkBufferSize": 200,
    "rawCdpEnabled": false,
    "viteMaxTargets": 32,
    "viteMaxTargetsPerOrigin": 8,
    "viteMaxFrameBytes": 1048576,
    "viteMaxConcurrentCalls": 4,
    "viteMaxFramesPerSecond": 16,
    "viteHeartbeatMs": 15000,
    "viteDisconnectMs": 45000,
    "viteReconnectWindowMs": 45000
  }
}
