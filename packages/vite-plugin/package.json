{
  "name": "@ycp424c/dsh-browser-bridge-vite",
  "description": "Vite plugin that injects the DSH browser bridge page runtime",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/index.d.ts.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ycp424c/dsh-browser-bridge-page-runtime": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ycp424c/dsh-browser-bridge.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
